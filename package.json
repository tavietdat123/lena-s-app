{
  "name": "lingua-vault-monorepo",
  "version": "1.0.0",
  "type": "module",
  "description": "LinguaVault - Personal English & Spaced Repetition Hub (Web, Mobile, Desktop, Server)",
  "scripts": {
    "start": "node server/src/index.js",
    "build": "npm --prefix server install && npm --prefix web install && npm --prefix web run build",
    "dev": "node run-dev.js",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:mobile": "npm --prefix mobile run start",
    "app:mac": "npm --prefix desktop run start",
    "app:mobile": "npm --prefix desktop run mobile",
    "build:web": "npm --prefix web run build",
    "test:all": "node server/test-all-features.js",
    "seed:topics": "node server/src/scripts/seedTopics.js"
  },
  "keywords": [
    "english",
    "spaced-repetition",
    "sm2",
    "srs",
    "gemini-ai",
    "sqlite",
    "react",
    "expo",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
